   "source": [
    "import os\n",
    "import yaml\n",
    "\n",
    "# Path to filtered dataset\n",
    "output_base = r\"C:\\Users\\redaj\\Desktop\\MultiModal-Diagnosis-AI\\Yolo\\filtered_data\"\n",
    "\n",
    "# Get the list of tumor classes from your dataset\n",
    "base_path = r\"C:\\Users\\redaj\\Desktop\\MultiModal-Diagnosis-AI\\Yolo\\data\"\n",
    "split = \"train\"\n",
    "tumor_classes = [d for d in os.listdir(os.path.join(base_path, split)) \n",
    "                if os.path.isdir(os.path.join(base_path, split, d))]\n",
    "\n",
    "# Create data.yaml content\n",
    "data_yaml = {\n",
    "    'path': output_base,                # Root directory\n",
    "    'train': 'images/train',            # Training images path (relative to path)\n",
    "    'val': 'images/val',                # Validation images path\n",
    "    'test': 'images/test',              # Test images path\n",
    "    \n",
    "    'nc': len(tumor_classes),           # Number of classes\n",
    "    'names': tumor_classes,             # Class names list\n",
    "    \n",
    "    # Explicitly disable augmentations\n",
    "    'augment': False,                   # Disable all augmentations\n",
    "    'degrees': 0,                       # No rotation\n",
    "    'translate': 0,                     # No translation\n",
    "    'scale': 0,                         # No scaling\n",
    "    'fliplr': 0,                        # No horizontal flips\n",
    "    'mosaic': 0                         # No mosaic augmentation\n",
    "}\n",
    "\n",
    "# Write data.yaml file\n",
    "yaml_path = os.path.join(output_base, 'data.yaml')\n",
    "with open(yaml_path, 'w') as f:\n",
    "    yaml.dump(data_yaml, f, default_flow_style=False, sort_keys=False)\n",
    "\n",
    "print(f\"Created data.yaml file at: {yaml_path}\")\n",
    "print(\"\\nContents:\")\n",
    "for key, value in data_yaml.items():\n",
    "    print(f\"{key}: {value}\")"
   ]
  },
