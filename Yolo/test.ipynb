    "import cv2\n",
    "import matplotlib.pyplot as plt\n",
    "import os\n",
    "\n",
    "# Set paths\n",
    "base_path = r\"C:\\Users\\redaj\\Desktop\\MultiModal-Diagnosis-AI\\Yolo\\data\"\n",
    "split = \"train\"\n",
    "\n",
    "# Get tumor classes\n",
    "tumor_classes = [d for d in os.listdir(os.path.join(base_path, split)) \n",
    "                if os.path.isdir(os.path.join(base_path, split, d))]\n",
    "print(f\"Found classes: {tumor_classes}\")\n",
    "\n",
    "# Show one sample per class\n",
    "for tumor_class in tumor_classes:\n",
    "    # Find first image with label\n",
    "    images_dir = os.path.join(base_path, split, tumor_class, \"images\")\n",
    "    labels_dir = os.path.join(base_path, split, tumor_class, \"labels\")\n",
    "    \n",
    "    \n",
    "        \n",
    "    # Get first image that has a label\n",
    "    for img_file in os.listdir(images_dir):\n",
    "        if not img_file.lower().endswith(('.jpg', '.jpeg', '.png')):\n",
    "            continue #mhnidwhax fdak li maxi image whnskipiw l next item\n",
    "            \n",
    "        label_file = os.path.splitext(img_file)[0] + \".txt\"  #For example, if img_file is \"brain_scan.jpg\", this function returns:\n",
    "                                                 #(\"brain_scan\", \".jpg\")\n",
    "        if os.path.exists(os.path.join(labels_dir, label_file)):\n",
    "            # Show this image\n",
    "            img = cv2.imread(os.path.join(images_dir, img_file))\n",
    "            img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB) #OpenCV loads images in BGR (Blue-Green-Red) color format by default\n",
    "#Matplotlib expects RGB (Red-Green-Blue) format for display\n",
    "#This line converts the color channels from BGR → RGB so the colors look correct when displayed\n",
    "            h, w, c = img.shape\n",
    "            \n",
    "            # Plot image and boxes\n",
    "            plt.figure(figsize=(8, 8))\n",
    "            plt.imshow(img)\n",
    "            plt.title(f\"{tumor_class}\")\n",
    "            \n",
    "            # Add boxes\n",
    "            with open(os.path.join(labels_dir, label_file), 'r') as f:\n",
    "                for line in f:\n",
    "                    parts = line.strip().split()\n",
    "                    x_center, y_center = float(parts[1]) * w, float(parts[2]) * h\n",
    "                    box_w, box_h = float(parts[3]) * w, float(parts[4]) * h\n",
    "                    \n",
    "                    # Draw rectangle\n",
    "                    x1, y1 = int(x_center - box_w/2), int(y_center - box_h/2)\n",
    "                    plt.gca().add_patch(plt.Rectangle((x1, y1), box_w, box_h, \n",
    "                                      fill=False, edgecolor='red', linewidth=2))\n",
    "            \n",
    "            plt.axis('off')\n",
    "            plt.show()\n",
    "            break"
   ]
  },
