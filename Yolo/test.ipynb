    "import os\n",
    "import shutil\n",
    "\n",
    "# Set paths\n",
    "base_path = r\"C:\\Users\\redaj\\Desktop\\MultiModal-Diagnosis-AI\\Yolo\\data\"\n",
    "output_path = r\"C:\\Users\\redaj\\Desktop\\MultiModal-Diagnosis-AI\\Yolo\\filtered_data\"\n",
    "\n",
    "# Process each split (train/val/test)\n",
    "for split in [\"train\", \"val\"]:\n",
    "    print(f\"\\nProcessing {split} split:\")\n",
    "    \n",
    "    # Stats\n",
    "    total_images = 0\n",
    "    images_with_labels = 0\n",
    "    images_without_labels = 0\n",
    "    \n",
    "    # Process each tumor class\n",
    "    tumor_classes = [d for d in os.listdir(os.path.join(base_path, split)) \n",
    "                    if os.path.isdir(os.path.join(base_path, split, d))]\n",
    "    \n",
    "    for tumor_class in tumor_classes:\n",
    "        images_dir = os.path.join(base_path, split, tumor_class, \"images\")\n",
    "        labels_dir = os.path.join(base_path, split, tumor_class, \"labels\")\n",
    "        \n",
    "        if not os.path.exists(images_dir) or not os.path.exists(labels_dir):\n",
    "            continue\n",
    "        \n",
    "        # Check each image\n",
    "        for img_file in os.listdir(images_dir):\n",
    "            if not img_file.lower().endswith(('.jpg', '.jpeg', '.png')):\n",
    "                continue\n",
    "                \n",
    "            total_images += 1\n",
    "            label_file = os.path.splitext(img_file)[0] + \".txt\"\n",
    "            \n",
    "            # Check if label exists\n",
    "            if os.path.exists(os.path.join(labels_dir, label_file)):\n",
    "                images_with_labels += 1\n",
    "                \n",
    "                # Copy to filtered data (optional)\n",
    "                shutil.copy2(os.path.join(images_dir, img_file), \n",
    "                            os.path.join(output_path, \"images\", split, img_file))\n",
    "                shutil.copy2(os.path.join(labels_dir, label_file),\n",
    "                            os.path.join(output_path, \"labels\", split, label_file))\n",
    "            else:\n",
    "                images_without_labels += 1\n",
    "    \n",
    "    # Print stats\n",
    "    print(f\"Total images: {total_images}\")\n",
    "    print(f\"Images with labels: {images_with_labels}\")\n",
    "    print(f\"Images without labels: {images_without_labels}\")"
